<!--
  Dark is the starting variant, not "Default": Enigma.Avalonia.Desktop defines Dark and Light theme
  dictionaries only, so on a host whose platform theme cannot be resolved "Default" would leave every
  Enigma* brush unresolved. The user's preference replaces it before the window is built (ThemeApplier).
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Enigma.Launchpad.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Enigma.Launchpad.Desktop/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- A ResourceDictionary, so a ResourceInclude here and not a StyleInclude. -->
        <ResourceInclude Source="avares://Enigma.Avalonia.Desktop/Themes/Fluent.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
