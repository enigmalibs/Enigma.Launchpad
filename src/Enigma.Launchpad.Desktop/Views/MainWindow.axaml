<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enigma.Launchpad.Desktop.ViewModels"
        xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
        xmlns:contentDialog="using:Enigma.Avalonia.Desktop.Controls.ContentDialog"
        xmlns:infoBar="using:Enigma.Avalonia.Desktop.Controls.InfoBar"
        xmlns:nav="using:Enigma.Avalonia.Desktop.Controls.Navigation"
        xmlns:ei="https://github.com/josueclement/Enigma.Icons"
        x:Class="Enigma.Launchpad.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Enigma Launchpad"
        Icon="/Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource EnigmaBackgroundBrush}">

  <Panel>
    <DockPanel>
      <nav:NavigationView x:Name="Rail"
                          DockPanel.Dock="Left"
                          Items="{Binding Navigation.Items}"
                          FooterItems="{Binding Navigation.FooterItems}"
                          SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                          Orientation="Vertical" />

      <!-- The profile in use, over every page: the list switches the shortcuts the pages show. -->
      <Border DockPanel.Dock="Top" Classes="appBar">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <ei:Icon Kind="UserCircle" Classes="toolbar" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="Profile" Classes="appBarLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="ProfileChoice"
                    ItemsSource="{Binding ProfileSwitcher.Profiles}"
                    SelectedItem="{Binding ProfileSwitcher.SelectedProfile, Mode=TwoWay}"
                    MinWidth="200"
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    ToolTip.Tip="The profile whose shortcuts are shown"
                    AutomationProperties.Name="Profile">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileOption">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="ManageProfilesButton"
                  Classes="ghost"
                  VerticalAlignment="Center"
                  Command="{Binding ManageProfilesCommand}"
                  ToolTip.Tip="Create, rename and delete profiles"
                  AutomationProperties.Name="Manage profiles">
            <ei:Icon Kind="UsersThree" Classes="toolbar" />
          </Button>
        </StackPanel>
      </Border>

      <ContentControl x:Name="PageHost" Content="{Binding Navigation.CurrentPage}" />
    </DockPanel>

    <!-- The three overlay hosts must be the last children of the root panel, so they draw over
         everything else. App registers them with their services before the window is shown. -->
    <contentDialog:ContentDialog x:Name="HostDialog"
                                 DialogMinWidth="380"
                                 DialogMaxWidth="640"
                                 DialogMaxHeight="640" />
    <controls:Overlay x:Name="HostOverlay" />
    <infoBar:InfoBar x:Name="HostInfoBar" />
  </Panel>
</Window>
