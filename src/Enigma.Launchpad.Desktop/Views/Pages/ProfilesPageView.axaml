<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:pages="using:Enigma.Launchpad.Desktop.ViewModels.Pages"
             x:Class="Enigma.Launchpad.Desktop.Views.Pages.ProfilesPageView"
             x:DataType="pages:ProfilesPageViewModel">

  <DockPanel>
    <!-- Page header, in the other pages' style, with the way to add a profile. -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,*,Auto"
          Margin="32,28,32,16">
      <Border Grid.Column="0" Classes="pageIcon" VerticalAlignment="Center">
        <ei:Icon Kind="UsersThree" Classes="pageIcon" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="14,0,0,0">
        <TextBlock Text="Profiles" Classes="pageTitle" />
        <TextBlock Text="Each profile keeps its own workspaces." Classes="pageDescription" />
      </StackPanel>
      <Button x:Name="NewProfileButton"
              Grid.Column="2"
              Classes="accent"
              VerticalAlignment="Center"
              Command="{Binding NewProfileCommand}"
              ToolTip.Tip="Create an empty profile"
              AutomationProperties.Name="New profile">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
          <TextBlock Text="New profile" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ProfileList"
                    ItemsSource="{Binding Profiles}"
                    Margin="32,4,32,32">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ProfileItemViewModel">
            <Border Classes="profileCard" Classes.active="{Binding IsActive}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="tileIcon" VerticalAlignment="Center">
                  <ei:Icon Kind="UserCircle" Classes="tileIcon" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" Classes="groupName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Classes="activeBadge" VerticalAlignment="Center" IsVisible="{Binding IsActive}">
                      <TextBlock Text="Active" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" Classes="pageDescription" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding UseCommand}"
                        IsVisible="{Binding !IsActive}"
                        ToolTip.Tip="Show this profile's shortcuts"
                        AutomationProperties.Name="{Binding Name, StringFormat='Use {0}'}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ei:Icon Kind="CheckCircle" Classes="toolbar" VerticalAlignment="Center" />
                    <TextBlock Text="Use" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Classes="ghost"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Profile actions"
                        AutomationProperties.Name="Profile actions">
                  <ei:Icon Kind="DotsThreeOutline" Classes="toolbar" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Rename…" Command="{Binding RenameCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="PencilSimple" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Duplicate…" Command="{Binding DuplicateCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="Copy" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Export…" Command="{Binding ExportCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="Export" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Import…" Command="{Binding ImportCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="DownloadSimple" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Move up" Command="{Binding MoveUpCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="ArrowUp" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Move down" Command="{Binding MoveDownCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="ArrowDown" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Delete…" Command="{Binding DeleteCommand}">
                        <MenuItem.Icon>
                          <ei:Icon Kind="Trash" Classes="menu" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
