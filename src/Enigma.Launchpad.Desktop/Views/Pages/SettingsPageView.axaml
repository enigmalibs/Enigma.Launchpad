<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             xmlns:pages="using:Enigma.Launchpad.Desktop.ViewModels.Pages"
             x:Class="Enigma.Launchpad.Desktop.Views.Pages.SettingsPageView"
             x:DataType="pages:SettingsPageViewModel">

  <DockPanel>
    <!-- Page header, in the other pages' style. -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,*"
          Margin="32,28,32,16">
      <Border Grid.Column="0" Classes="pageIcon" VerticalAlignment="Center">
        <ei:Icon Kind="Gear" Classes="pageIcon" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="14,0,0,0">
        <TextBlock Text="Settings" Classes="pageTitle" />
        <TextBlock Text="How the launchpad looks and behaves." Classes="pageDescription" />
      </StackPanel>
    </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <!-- A column with a ceiling, aligned with the header: settings rows read badly stretched across a
           wide window, and a column sized to its content would change width with the data folder's path. -->
      <Grid Margin="32,4,32,32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="8">

          <TextBlock Text="Appearance" Classes="sectionHeader" />
          <controls:SettingsCard Header="Theme"
                                 Description="Light, dark, or whatever the system is set to."
                                 IconData="{ei:IconGeometry Palette}">
            <ComboBox x:Name="ThemeChoice"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      MinWidth="200"
                      AutomationProperties.Name="Theme">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pages:ThemeOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:SettingsCard>

          <TextBlock Text="Launching" Classes="sectionHeader" />
          <controls:SettingsCard Header="Minimize after opening a shortcut"
                                 Description="Step aside once an application, a folder or a link is opened."
                                 IconData="{ei:IconGeometry ArrowsIn}">
            <ToggleSwitch x:Name="MinimizeSwitch"
                          IsChecked="{Binding MinimizeAfterLaunch, Mode=TwoWay}"
                          OnContent="On"
                          OffContent="Off"
                          AutomationProperties.Name="Minimize after opening a shortcut" />
          </controls:SettingsCard>

          <TextBlock Text="Data" Classes="sectionHeader" />
          <controls:SettingsCard Header="Data folder"
                                 Description="{Binding DataDirectory}"
                                 IconData="{ei:IconGeometry FolderOpen}">
            <Button x:Name="OpenDataFolderButton"
                    Command="{Binding OpenDataFolderCommand}"
                    ToolTip.Tip="Open the folder holding your shortcuts and settings"
                    AutomationProperties.Name="Open the data folder">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ei:Icon Kind="ArrowSquareOut" Classes="toolbar" VerticalAlignment="Center" />
                <TextBlock Text="Open folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </controls:SettingsCard>

          <TextBlock Text="About" Classes="sectionHeader" />
          <controls:SettingsCard Header="Enigma Launchpad"
                                 Description="Released under the MIT license."
                                 IconData="{ei:IconGeometry Info}">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock x:Name="VersionText"
                         Text="{Binding Version, StringFormat='Version {0}'}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
              <!-- The About dialog every Enigma app shows: the icon, the build and the copyright. -->
              <Button x:Name="OpenAboutButton"
                      Command="{Binding OpenAboutCommand}"
                      Content="About Enigma Launchpad"
                      AutomationProperties.Name="About Enigma Launchpad" />
            </StackPanel>
          </controls:SettingsCard>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
