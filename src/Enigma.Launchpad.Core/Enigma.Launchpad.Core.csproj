<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Single-TFM on purpose: this library is app-internal (it ships only inside
         Enigma.Launchpad.Desktop) and is never published to NuGet, so multi-targeting
         netstandard2.0 would only buy polyfills no consumer needs. -->
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Enigma.Launchpad.Core</RootNamespace>
  </PropertyGroup>
  <!-- LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors are deliberately absent:
       they come from Directory.Build.props. No Version attributes either — versions live in
       Directory.Packages.props (CPM). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Enigma.Launchpad.Core.UnitTests" />
  </ItemGroup>
</Project>
